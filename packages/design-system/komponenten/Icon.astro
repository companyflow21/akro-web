export type SymbolName = keyof typeof SYMBOLE;

interface Props {
  name: SymbolName;
  class?: string;
}

const { name, class: klasse = 'ico' } = Astro.props;
const [viewBox, inhalt] = SYMBOLE[name];
---

<svg class={klasse} viewBox={viewBox} aria-hidden="true" set:html={inhalt} />
