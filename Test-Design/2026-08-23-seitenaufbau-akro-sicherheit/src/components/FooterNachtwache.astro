---
/**
 * Fußbereich der Designalternative "Nachtwache". Gleiche Inhalte und
 * Links wie Footer.astro, das Sperrstreifen-Band schließt die Seite wie
 * es der Header eröffnet hat.
 */
import { marke, rechtsnavigation } from '../config';
import { leistungen } from '../data/leistungen';

const jahr = new Date().getFullYear();
---

<div class="stripe-divider"></div>
<footer class="bg-ink text-slate">
	<div class="mx-auto max-w-6xl px-5 py-14 md:px-8">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<nav aria-label="Leistungen">
				<p class="tech text-signal">Einsatzregister</p>
				<ul class="mt-4 space-y-2.5">
					{
						leistungen.map((l) => (
							<li>
								<a
									href={`/leistungen/${l.slug}`}
									class="text-[0.9rem] text-slate/70 hover:text-slate"
								>
									{l.titel}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label="Unternehmen">
				<p class="tech text-signal">Unternehmen</p>
				<ul class="mt-4 space-y-2.5">
					<li><a href="/unternehmen" class="text-[0.9rem] text-slate/70 hover:text-slate">Unternehmen</a></li>
					<li><a href="/referenzen" class="text-[0.9rem] text-slate/70 hover:text-slate">Referenzen</a></li>
					<li><a href="/karriere" class="text-[0.9rem] text-slate/70 hover:text-slate">Karriere</a></li>
				</ul>
			</nav>

			<div>
				<p class="tech text-signal">Kontakt</p>
				<address class="mt-4 space-y-2.5 text-[0.9rem] not-italic text-slate/70">
					<p>
						{marke.traeger}<br />
						{marke.strasse}<br />
						{marke.plz} {marke.ort}
					</p>
					<p>
						<a href={marke.telefonHref} class="hover:text-slate">{marke.telefon}</a><br />
						<a href={`mailto:${marke.email}`} class="hover:text-slate">{marke.email}</a>
					</p>
				</address>
				<ul class="mt-3 space-y-2.5">
					<li><a href="/kontakt" class="text-[0.9rem] text-slate/70 hover:text-slate">Kontakt</a></li>
					<li><a href="/anfrage" class="text-[0.9rem] text-slate/70 hover:text-slate">Anfrage stellen</a></li>
				</ul>
			</div>

			<nav aria-label="Rechtliches">
				<p class="tech text-signal">Rechtliches</p>
				<ul class="mt-4 space-y-2.5">
					{
						rechtsnavigation.map((eintrag) => (
							<li>
								<a
									href={eintrag.href}
									class="text-[0.9rem] text-slate/70 hover:text-slate"
								>
									{eintrag.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div
			class="mt-12 flex flex-col gap-3 border-t border-ink-3 pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="tech text-slate/75">
				© {jahr} {marke.traeger} · Niederlassung {marke.niederlassung} ·
				Designentwurf „Nachtwache" — nicht produktiv
			</p>
		</div>
	</div>
</footer>
