---
/**
 * Kompakter Verlauf-Kopfbereich für Unterseiten im Entwurf "Klarsicht".
 * Gemeinsam von Leistungen-Übersicht und Leistungsdetail genutzt, damit
 * beide garantiert gleich aussehen statt einzeln nachgebaut zu werden.
 */
interface Props {
  eyebrow: string;
  titel: string;
  subline?: string;
}

const { eyebrow, titel, subline } = Astro.props;
---

<section class="bg-linear-to-br from-[var(--color-grad-1)] via-[var(--color-grad-2)] to-[var(--color-grad-3)] text-white">
	<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
		<p class="text-sm font-semibold uppercase tracking-wide text-white/70">
			{eyebrow}
		</p>
		<h1 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight md:text-5xl">
			{titel}
		</h1>
		{
			subline && (
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/85">
					{subline}
				</p>
			)
		}
	</div>
</section>
