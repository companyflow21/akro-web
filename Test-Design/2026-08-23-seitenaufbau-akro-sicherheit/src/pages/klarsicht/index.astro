---
/**
 * Designalternative "Klarsicht" — Startseite.
 * Mischung: Vitrine (helle Verlauf-/Glass-Ästhetik) als tragende Basis,
 * Nachtwache liefert zwei Prinzipien: kühlere Farbgebung und ein
 * einziger, ausschließlich dem CTA vorbehaltener Akzent (Signal).
 * Gleiche freigegebene Inhalte wie die Startseite unter /, neu
 * gestaltet. Nur zum Vergleich, noindex, nicht produktiv.
 */
import BaseLayoutKlarsicht from '../../layouts/BaseLayoutKlarsicht.astro';
import ServiceShowcase from '../../components/klarsicht/ServiceShowcase.astro';
import { marke } from '../../config';
import { leistungen } from '../../data/leistungen';
import { organisation } from '../../lib/jsonld';

const prozess = [
  {
    nr: '01',
    titel: 'Anfrage & Analyse',
    text: 'Sie schildern Ihren Bedarf, Ort und Zeitraum. Wir analysieren Ihre spezifischen Gefährdungspotenziale im Detail.',
  },
  {
    nr: '02',
    titel: 'Sicherheitskonzept',
    text: 'Wir erstellen ein maßgeschneidertes Dienstleistungsprofil inklusive Service Level Agreement (SLA), Personalprofil und Dokumentationsvorgaben.',
  },
  {
    nr: '03',
    titel: 'Operativer Einsatz',
    text: 'Die AKRO-Einsatzleitung übernimmt die vollständige Disposition. Unsere qualifizierten Sicherheitskräfte setzen die Dienstanweisung vor Ort um.',
  },
  {
    nr: '04',
    titel: 'Laufende Betreuung',
    text: 'Wir garantieren kontinuierliche Qualitätssicherung durch regelmäßige Audits, KPI-Reviews und eine direkte Ansprechbarkeit.',
  },
];
---

<BaseLayoutKlarsicht
	title="Sicherheitsdienst & Werkschutz für B2B-Kunden | AKRO Sicherheit"
	description="Die AKRO GmbH übernimmt Sicherheitsdienstleistungen für Industrie, Gewerbe und Veranstaltungen. Eigenverantwortliche Ausführung und professioneller Schutz."
	noindex
	jsonLd={organisation()}
>
	{/* Hero */}
	<section class="relative overflow-hidden bg-linear-to-br from-[var(--color-grad-1)] via-[var(--color-grad-2)] to-[var(--color-grad-3)] text-white">
		<div class="relative mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-sm font-semibold uppercase tracking-wide text-white/70">
					{marke.traeger} · Sicherheitsdienstleistungen
				</p>
				<h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">
					Professionelle Sicherheitsdienstleistungen für Industrie und
					Gewerbe
				</h1>
				<p class="mt-5 text-lg leading-relaxed text-white/85">
					Die {marke.traeger} übernimmt Bewachungsaufgaben und
					Sicherheitsdienste für gewerbliche und öffentliche Auftraggeber.
					Wir schützen Ihre Objekte, Baustellen und Veranstaltungen durch
					eigenverantwortlich geplante und durchgeführte
					Sicherheitskonzepte.
				</p>

				<div class="mt-8 flex flex-wrap justify-center gap-3">
					<a
						href="/anfrage"
						class="rounded-full bg-signal px-6 py-3.5 text-sm font-semibold text-on-signal hover:brightness-95"
					>
						Anfrage stellen
					</a>
					<a
						href={marke.telefonHref}
						class="rounded-full border border-white/40 px-6 py-3.5 text-sm font-semibold text-white hover:border-white"
					>
						{marke.telefon}
					</a>
				</div>
			</div>

			<ServiceShowcase leistungen={leistungen} />
		</div>

		<svg
			class="absolute inset-x-0 bottom-0 block h-10 w-full text-white md:h-14"
			viewBox="0 0 1440 80"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				fill="currentColor"
				d="M0 40 C 240 90 480 0 720 20 C 960 40 1200 90 1440 30 L1440 80 L0 80 Z"
			/>
		</svg>
	</section>

	{/* Leistungsportfolio */}
	<section class="bg-white">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
					Unser Leistungsportfolio
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-slate-600">
					Die {marke.traeger} führt spezifische Sicherheitsgewerke aus. Wir
					gewährleisten die vertragskonforme Erbringung der vereinbarten
					Leistungen.
				</p>
			</div>

			<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					leistungen.map((l, i) => (
						<a
							href={`/leistungen/${l.slug}`}
							class:list={[
								'glass-card group p-7',
								i === leistungen.length - 1 && 'lg:col-span-2',
							]}
						>
							<h3 class="text-lg font-semibold text-slate-900">{l.titel}</h3>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-600">
								{l.kurz}
							</p>
							<span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent group-hover:gap-2">
								Details →
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	{/* Prozess */}
	<section class="bg-slate-50">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
					So arbeiten wir
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-slate-600">
					Klarer Ablauf. Verbindliche Umsetzung. Revisionssichere Nachweise.
				</p>
			</div>

			<div class="mx-auto mt-16 grid max-w-4xl grid-cols-1 gap-8 lg:grid-cols-2">
				{
					prozess.map((p) => (
						<div class="glass-card relative p-8 pt-10">
							<span class="step-badge absolute -left-4 -top-4 flex h-12 w-12 items-center justify-center rounded-full text-sm font-bold text-white shadow-md">
								{p.nr}
							</span>
							<h3 class="text-lg font-semibold text-slate-900">{p.titel}</h3>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-600">
								{p.text}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	{/* Abschluss-CTA — einziger Ort mit Signal-Fläche */}
	<section class="bg-signal text-on-signal">
		<div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-14 text-center md:px-8 md:py-16 lg:flex-row lg:items-center lg:justify-between lg:text-left">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-on-signal/70">
					Anfrage
				</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
					Besprechen Sie Ihren Sicherheitsbedarf mit uns
				</h2>
				<p class="mt-4 text-lg text-on-signal/85">
					Jedes Objekt erfordert eine individuelle Betrachtung. Wir stehen
					für die Planung Ihres Sicherheitsauftrags zur Verfügung.
				</p>
			</div>
			<div class="flex shrink-0 flex-wrap justify-center gap-3">
				<a
					href="/anfrage"
					class="rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white hover:bg-slate-900"
				>
					Anfrage stellen
				</a>
				<a
					href={marke.telefonHref}
					class="rounded-full border border-on-signal/40 px-6 py-3.5 text-sm font-semibold text-on-signal hover:border-on-signal/70"
				>
					{marke.telefon}
				</a>
			</div>
		</div>
	</section>
</BaseLayoutKlarsicht>
