---
/**
 * Designalternative "Klarsicht" — Leistungen-Übersicht.
 * Nutzt den gemeinsamen GradientPageHeader statt eines eigenen großen
 * Heros, damit diese Seite garantiert zur Startseite und zum
 * Leistungsdetail passt. Inhalte aus dem bereits vorliegenden Konzept
 * für /leistungen, keine neuen Texte. Nur zum Vergleich, noindex.
 */
import BaseLayoutKlarsicht from '../../../layouts/BaseLayoutKlarsicht.astro';
import GradientPageHeader from '../../../components/klarsicht/GradientPageHeader.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { leistungen } from '../../../data/leistungen';
import { brotkrumen } from '../../../lib/jsonld';

const pfad = [
  { label: 'Startseite', href: '/klarsicht' },
  { label: 'Leistungen', href: '/klarsicht/leistungen' },
];
---

<BaseLayoutKlarsicht
	title="Sicherheitsdienstleistungen für Industrie & Gewerbe | AKRO Sicherheit"
	description="Übersicht unserer B2B-Sicherheitsdienste: Objektschutz, Baustellenbewachung, Revierdienst, Veranstaltungssicherheit und KRITIS-Schutz. Eigenverantwortlich und verlässlich."
	noindex
	jsonLd={brotkrumen(pfad)}
>
	<Breadcrumb eintraege={pfad} />

	<GradientPageHeader
		eyebrow="Leistungen"
		titel="Unsere Sicherheitsleistungen"
		subline="Wählen Sie den Bereich, der Ihren Anforderungen entspricht. Wir garantieren bei jedem Gewerk eine vertragskonforme, dokumentierte Ausführung durch unsere eigene Einsatzleitung."
	/>

	<section class="bg-white">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					leistungen.map((l, i) => (
						<a
							href={`/leistungen/${l.slug}`}
							class:list={[
								'glass-card group p-7',
								i === leistungen.length - 1 && 'lg:col-span-2',
							]}
						>
							<h2 class="text-lg font-semibold text-slate-900">{l.titel}</h2>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-600">
								{l.kurz}
							</p>
							<span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent group-hover:gap-2">
								Details →
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-signal text-on-signal">
		<div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-14 text-center md:px-8 md:py-16 lg:flex-row lg:items-center lg:justify-between lg:text-left">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-on-signal/70">
					Anfrage
				</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
					Bereit für ein verbindliches Angebot?
				</h2>
				<p class="mt-4 text-lg text-on-signal/85">
					Wir melden uns zeitnah – mit klaren Konzepten und umsetzbaren
					Lösungen für Ihre Sicherheit.
				</p>
			</div>
			<div class="flex shrink-0 flex-wrap justify-center gap-3">
				<a
					href="/anfrage"
					class="rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white hover:bg-slate-900"
				>
					Bewachung anfragen
				</a>
				<a
					href="/kontakt"
					class="rounded-full border border-on-signal/40 px-6 py-3.5 text-sm font-semibold text-on-signal hover:border-on-signal/70"
				>
					Kontakt aufnehmen
				</a>
			</div>
		</div>
	</section>
</BaseLayoutKlarsicht>
