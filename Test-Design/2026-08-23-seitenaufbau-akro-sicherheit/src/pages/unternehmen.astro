---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { marke } from '../config';
import { brotkrumen } from '../lib/jsonld';

const pfad = [
  { label: 'Startseite', href: '/' },
  { label: 'Unternehmen', href: '/unternehmen' },
];
---

<BaseLayout
	title="Unternehmen | AKRO Sicherheit"
	description="Die AKRO GmbH erbringt Sicherheitsdienstleistungen als eigenverantwortlich organisierte Leistung — mit eigener Einsatzplanung, Nachweisprüfung und Dokumentation."
	jsonLd={brotkrumen(pfad)}
>
	<Breadcrumb eintraege={pfad} />

	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
			<SectionHead
				eyebrow="Unternehmen"
				titel="Wir erbringen die Leistung, nicht nur die Besetzung."
				as="h1"
			>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
					Die {marke.traeger} erbringt Sicherheitsdienstleistungen als
					eigenverantwortlich organisierte Leistung. Auswahl und Anzahl der
					eingesetzten Kräfte, Einsatzplanung, Arbeitszeiten, Vertretung und
					Führung liegen bei uns. Sie beauftragen ein Ergebnis nach
					Leistungsverzeichnis.
				</p>
			</SectionHead>
		</div>
	</section>

	<section class="border-y border-line bg-sand-2">
		<div
			class="mx-auto grid max-w-6xl gap-12 px-5 py-14 md:px-8 md:py-16 lg:grid-cols-[1fr_0.8fr] lg:gap-16"
		>
			<div class="prose">
				<h2>Wie wir arbeiten</h2>
				<p class="text-muted">
					Jeder Auftrag beginnt mit einem abgestimmten Leistungsverzeichnis.
					Darin steht, was zu tun ist, in welchem Zeitraum und in welcher
					Besetzung. Die Umsetzung planen und steuern wir selbst.
				</p>

				<h3>Nachweisprüfung vor dem Einsatz</h3>
				<p class="text-muted">
					Vor jedem Einsatz prüfen wir, ob die vorgesehenen Kräfte die
					erforderlichen Nachweise besitzen und ob diese gültig sind. Fehlt ein
					Nachweis oder ist er abgelaufen, erfolgt kein Einsatz.
				</p>

				<h3>Dokumentation</h3>
				<p class="text-muted">
					Kontrollgänge und besondere Vorkommnisse werden dokumentiert. Sie
					erhalten nachvollziehbare Protokolle in der vereinbarten Form.
				</p>

				<h3>Ansprechpartner</h3>
				<p class="text-muted">
					Für jeden Auftrag ist ein fester Ansprechpartner zuständig — für
					Abstimmung, Rückfragen und Eskalation.
				</p>

				<p class="mt-8 text-sm">
					<span class="todo">TODO</span>
					Angaben zu Unternehmensgeschichte, Erfahrung, Einsatzumfang,
					Mitarbeiterzahl, Zertifizierungen und Verbandsmitgliedschaften
					ergänzen, sobald sie belegt und freigegeben sind.
				</p>
			</div>

			<aside class="h-fit border border-line bg-surface p-7">
				<p class="tech text-muted">Rechtsträger</p>
				<p class="mt-3 text-xl font-semibold">{marke.traeger}</p>
				<dl class="mt-6 space-y-4 text-[0.95rem]">
					<div>
						<dt class="tech text-muted">Sitz</dt>
						<dd class="mt-1">{marke.strasse}<br />{marke.plz} {marke.ort}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Niederlassung</dt>
						<dd class="mt-1">{marke.niederlassung}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Geschäftsführer</dt>
						<dd class="mt-1">{marke.geschaeftsfuehrer}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Telefon</dt>
						<dd class="mt-1">
							<a href={marke.telefonHref} class="hover:text-brand">
								{marke.telefon}
							</a>
						</dd>
					</div>
					<div>
						<dt class="tech text-muted">E-Mail</dt>
						<dd class="mt-1">
							<a href={`mailto:${marke.email}`} class="hover:text-brand">
								{marke.email}
							</a>
						</dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>

	<CtaBand />
</BaseLayout>
