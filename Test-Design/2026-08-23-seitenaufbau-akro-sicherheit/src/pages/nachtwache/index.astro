---
/**
 * Designalternative "Nachtwache" — gleiche freigegebene Inhalte wie die
 * Startseite unter /, neu gestaltet: eigene Farbwelt, eigene Typografie,
 * eigener Seitenaufbau (Register-Liste statt Kachelraster, Sperrstreifen
 * statt Haarlinie). Nur zum Vergleich, noindex, nicht produktiv.
 */
import BaseLayoutNachtwache from '../../layouts/BaseLayoutNachtwache.astro';
import { marke } from '../../config';
import { leistungen } from '../../data/leistungen';
import { organisation } from '../../lib/jsonld';

const ablauf = [
  {
    nr: '01',
    titel: 'Anfrage',
    text: 'Sie schildern Objekt, Zeitraum und Anforderungen.',
  },
  {
    nr: '02',
    titel: 'Abstimmung',
    text: 'Wir stimmen Leistungsverzeichnis, Besetzung und Ablauf mit Ihnen ab.',
  },
  {
    nr: '03',
    titel: 'Einsatz',
    text: 'Wir planen die Besetzung, führen den Einsatz durch und dokumentieren ihn.',
  },
];

const lagebericht = [
  { label: 'Einsatzplanung', text: 'in eigener Verantwortung' },
  { label: 'Qualifikation', text: 'Nachweise je Einsatz geprüft' },
  { label: 'Dokumentation', text: 'nachvollziehbare Kontrollprotokolle' },
  { label: 'Ansprechpartner', text: 'fest zugeordnet' },
];
---

<BaseLayoutNachtwache
	title="Sicherheitsdienst & Werkschutz für B2B-Kunden | AKRO Sicherheit — Entwurf Nachtwache"
	description="Die AKRO GmbH übernimmt Sicherheitsdienstleistungen für Industrie, Gewerbe und Veranstaltungen. Eigenverantwortliche Ausführung und professioneller Schutz."
	noindex
	jsonLd={organisation()}
>
	{/* Hero */}
	<section class="beam text-slate">
		<div class="mx-auto grid max-w-6xl gap-12 px-5 pb-16 pt-14 md:px-8 md:pb-24 md:pt-20 lg:grid-cols-[7fr_5fr] lg:gap-16">
			<div class="min-w-0 flex flex-col justify-end">
				<p class="tech flex items-center gap-2 text-accent">
					<span class="inline-block h-2 w-2 bg-accent"></span>
					{marke.traeger} · Sicherheitsdienstleistungen
				</p>

				<h1 class="mt-6 break-words font-[family-name:var(--font-display)] text-[1.85rem] font-bold uppercase leading-[1.05] tracking-tight sm:text-[2.5rem] md:text-6xl lg:text-[4rem]">
					Professionelle Sicherheitsdienstleistungen für Industrie und Gewerbe
				</h1>

				<p class="mt-6 max-w-xl text-lg leading-relaxed text-slate/75">
					Die {marke.traeger} übernimmt Bewachungsaufgaben und
					Sicherheitsdienste für gewerbliche und öffentliche Auftraggeber.
					Wir schützen Ihre Objekte, Baustellen und Veranstaltungen durch
					eigenverantwortlich geplante und durchgeführte
					Sicherheitskonzepte.
				</p>

				<div class="mt-9 flex flex-wrap gap-3">
					<a
						href="/anfrage"
						class="inline-flex items-center px-6 py-3.5 text-sm font-semibold text-on-signal bg-signal hover:bg-[color-mix(in_srgb,var(--color-signal)_85%,white)]"
					>
						Anfrage stellen
					</a>
					<a
						href={marke.telefonHref}
						class="inline-flex items-center border border-slate/35 px-6 py-3.5 text-sm font-semibold text-slate hover:border-slate/70"
					>
						{marke.telefon}
					</a>
				</div>
			</div>

			<div class="flex min-w-0 flex-col gap-4">
				{/* TODO: Hier echtes, markenkonformes Bildmaterial (keine
				    KI-Generierung für reale Nachweise) in Blau/Cyan-Tonalität
				    einfügen. */}
				<div
					class="relative flex aspect-[4/3] items-center justify-center overflow-hidden border border-line/60 bg-ink-2"
					aria-hidden="true"
				>
					<span class="tech border border-dashed border-accent/60 px-3 py-1.5 text-accent">
						Bildmaterial folgt
					</span>
				</div>

				<div class="min-w-0 border border-slate/25 bg-ink-2/60 p-1">
					<h2 class="tech px-4 pt-4 text-slate/80">Einsatzregister</h2>
					<ul class="mt-2">
						{
							leistungen.map((l) => (
								<li>
									<a
										href={`/leistungen/${l.slug}`}
										class="manifest-row flex items-center gap-3 border-t border-slate/25 px-4 py-3"
									>
										<span class="tech w-7 shrink-0 text-accent">{l.kuerzel}</span>
										<h3 class="text-[0.92rem] text-slate/85">{l.titel}</h3>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	{/* Lagebericht */}
	<section class="bg-slate-2">
		<div class="mx-auto max-w-6xl px-5 py-10 md:px-8">
			<dl class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
				{
					lagebericht.map((k) => (
						<div class="flex items-start gap-2.5">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" />
							<div>
								<dt class="tech text-brand">{k.label}</dt>
								<dd class="mt-2 text-[0.95rem] text-ink/80">{k.text}</dd>
							</div>
						</div>
					))
				}
			</dl>
			<p class="mt-8 border-t border-line pt-4 text-sm text-muted">
				<span class="tech mr-1 inline-block border border-dashed border-signal bg-signal/15 px-1.5 py-0.5 text-[0.7rem] text-[color-mix(in_srgb,var(--color-signal)_55%,var(--color-ink))]">
					TODO
				</span>
				Zertifikate, Normen und Kennzahlen erscheinen erst, wenn die
				Originalnachweise geprüft und zur Veröffentlichung freigegeben sind.
			</p>
		</div>
	</section>

	<div class="stripe-divider"></div>

	{/* Einsatzregister — Liste statt Kachelraster */}
	<section class="bg-surface">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
			<p class="tech flex items-center gap-2 text-brand">
				<span class="inline-block h-2 w-2 bg-brand"></span>
				Leistungen
			</p>
			<h2 class="mt-4 break-words font-[family-name:var(--font-display)] text-3xl font-bold uppercase tracking-tight md:text-[2.6rem]">
				Unser Leistungsportfolio
			</h2>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
				Die {marke.traeger} führt spezifische Sicherheitsgewerke aus. Wir
				gewährleisten die vertragskonforme Erbringung der vereinbarten
				Leistungen:
			</p>

			<ul class="mt-10 border-y border-line">
				{
					leistungen.map((l) => (
						<li>
							<a
								href={`/leistungen/${l.slug}`}
								class="manifest-row flex flex-col gap-1.5 border-b border-line px-1 py-5 sm:flex-row sm:items-center sm:gap-6 sm:py-6"
							>
								<span class="tech w-10 shrink-0 text-brand">{l.kuerzel}</span>
								<h3 class="break-words font-[family-name:var(--font-display)] text-lg font-semibold uppercase tracking-tight sm:w-72 sm:shrink-0">
									{l.titel}
								</h3>
								<span class="text-[0.95rem] text-muted sm:flex-1">
									{l.kurz}
								</span>
								<span class="tech shrink-0 text-brand">Zur Leistung →</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<div class="stripe-divider"></div>

	{/* Ablauf */}
	<section class="bg-ink-2 text-slate">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
			<p class="tech flex items-center gap-2 text-accent">
				<span class="inline-block h-2 w-2 bg-accent"></span>
				Ablauf
			</p>
			<h2 class="mt-4 break-words font-[family-name:var(--font-display)] text-3xl font-bold uppercase tracking-tight md:text-[2.6rem]">
				Von der Anfrage bis zum Einsatz
			</h2>

			<ol class="mt-14 grid gap-10 pl-8 md:grid-cols-3 md:gap-8">
				{
					ablauf.map((s) => (
						<li class="waypoint">
							<span class="tech text-accent">{s.nr}</span>
							<h3 class="mt-3 text-xl font-semibold">{s.titel}</h3>
							<p class="mt-2 text-[0.95rem] leading-relaxed text-slate/70">
								{s.text}
							</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* Auftragsverhältnis */}
	<section class="bg-slate-2">
		<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
			<div>
				<p class="tech flex items-center gap-2 text-brand">
					<span class="inline-block h-2 w-2 bg-brand"></span>
					Auftragsverhältnis
				</p>
				<h2 class="mt-4 break-words font-[family-name:var(--font-display)] text-3xl font-bold uppercase tracking-tight md:text-[2.6rem]">
					Eigenverantwortliche Dienstleistungserbringung
				</h2>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
					Sicherheit erfordert klare Verantwortlichkeiten. Die {marke.traeger} agiert
					ausschließlich als eigenverantwortlicher Dienstleister. Die
					Organisation, Einsatzplanung und Durchführung der
					Bewachungsaufgaben obliegen vollständig uns. Wir setzen unser
					Personal zielgerichtet ein, um die mit Ihnen im Vorfeld
					definierten Sicherheitsanforderungen vertragsgemäß zu erfüllen.
				</p>
				<p class="mt-6">
					<a href="/unternehmen" class="tech text-brand">
						Mehr über das Unternehmen →
					</a>
				</p>
			</div>

			<aside class="border border-line bg-surface p-7">
				<p class="tech text-muted">Rechtsträger</p>
				<p class="mt-3 text-xl font-semibold">{marke.traeger}</p>
				<dl class="mt-6 space-y-4 text-[0.95rem]">
					<div>
						<dt class="tech text-muted">Sitz</dt>
						<dd class="mt-1">{marke.strasse}, {marke.plz} {marke.ort}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Niederlassung</dt>
						<dd class="mt-1">{marke.niederlassung}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Telefon</dt>
						<dd class="mt-1">
							<a href={marke.telefonHref} class="hover:text-brand">
								{marke.telefon}
							</a>
						</dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>

	{/* Abschluss-CTA — der einzige Ort mit Signal-Fläche */}
	<section class="bg-signal text-on-signal">
		<div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-14 md:px-8 md:py-16 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-2xl">
				<p class="tech text-on-signal/75">Anfrage</p>
				<h2 class="mt-4 break-words font-[family-name:var(--font-display)] text-3xl font-bold uppercase tracking-tight md:text-4xl">
					Besprechen Sie Ihren Sicherheitsbedarf mit uns
				</h2>
				<p class="mt-4 text-lg text-on-signal/80">
					Jedes Objekt erfordert eine individuelle Betrachtung. Wir stehen
					für die Planung Ihres Sicherheitsauftrags zur Verfügung.
				</p>
			</div>
			<div class="flex shrink-0 flex-wrap gap-3">
				<a
					href="/anfrage"
					class="inline-flex items-center bg-ink px-6 py-3.5 text-sm font-semibold text-slate hover:bg-ink-2"
				>
					Anfrage stellen
				</a>
				<a
					href={marke.telefonHref}
					class="inline-flex items-center border border-on-signal/40 px-6 py-3.5 text-sm font-semibold text-on-signal hover:border-on-signal/70"
				>
					{marke.telefon}
				</a>
			</div>
		</div>
	</section>
</BaseLayoutNachtwache>
