---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rechtstext from '@akro/design-system/komponenten/Rechtstext.astro';
import DatenschutzText from '@akro/design-system/komponenten/DatenschutzText.astro';
import { firma } from '../config';
---

<BaseLayout
  title="Datenschutzerklärung – AKRO GmbH"
  description="Datenschutzerklärung der AKRO GmbH: Server-Logfiles, Hosting, Kontaktaufnahme und Ihre Rechte nach DSGVO."
>
<Rechtstext titel="Datenschutzerklärung">
  <DatenschutzText email={firma.email} stand="5. September 2026" />
</Rechtstext>
</BaseLayout>
