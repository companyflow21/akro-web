---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '@akro/design-system/komponenten/Icon.astro';
import Kunst from '@akro/design-system/komponenten/Kunst.astro';
import { SITE_URL, firma, sparten, zertifikate } from '../config';
import logo from '@akro/assets/brand/akro/akro-wortmarke.svg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#unternehmen`,
  name: firma.name,
  url: `${SITE_URL}/`,
  logo: new URL(logo.src, SITE_URL).href,
  telephone: firma.telefonSchema,
  email: firma.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.strasse,
    postalCode: firma.plz,
    addressLocality: firma.ort,
    addressCountry: firma.land,
  },
};
---

<BaseLayout
  title="AKRO GmbH – Sicherheit, Brandschutz und Service"
  description="Drei Geschäftsbereiche, ein Vertragspartner: AKRO GmbH für Sicherheit, Brandschutz und Service. Sitz in Saarlouis, Niederlassung in Bonn."
  jsonLd={jsonLd}
>
  <section class="wrap" aria-labelledby="titel">
    <div class="buehne">
      <div class="buehne-text">
        <p class="etikett"><i></i>AKRO GmbH · Saarlouis und Bonn</p>
        <h1 id="titel">Sicherheit.<br />Brandschutz.<br />Service.</h1>
        <p class="lead">Drei Geschäftsbereiche, ein Vertragspartner. Wir übernehmen Verantwortung für Ihre Standorte.</p>
      </div>
      <div class="kunst-rahmen"><Kunst id="g" /></div>
    </div>

    <div class="tueren" id="bereiche">
      {
        sparten.map((s) => {
          const Tag = s.online ? 'a' : 'article';
          return (
            <Tag class={`tuer ${s.welt}`} {...(s.online ? { href: `https://${s.domain}/` } : {})}>
              <Icon name={s.icon} class="ico-gross" />
              <small>{s.domain}</small>
              <h2>{s.name}</h2>
              <p>{s.text}</p>
              {s.online ? (
                <span class="pfeil"><Icon name="pfeilSchraeg" /></span>
              ) : (
                <span class="bald">Website folgt</span>
              )}
            </Tag>
          );
        })
      }
    </div>
  </section>

  <section class="wrap ueber" id="unternehmen" aria-labelledby="ueber-titel">
    <div>
      <p class="notiz">Unternehmen</p>
      <h2 id="ueber-titel">Wir übernehmen Leistungen – nicht nur Personal.</h2>
    </div>
    <ul class="fakten">
      <li><b>Werkleistung</b><span>Organisation, Einsatzplanung und Ausführung liegen bei AKRO.</span></li>
      <li><b>Ein Vertrag</b><span>Sicherheit, Brandschutz und Service aus einer Hand.</span></li>
      <li><b>Standorte</b><span>Sitz in Saarlouis, Niederlassung in Bonn.</span></li>
    </ul>
  </section>

  <section class="zertifikate" id="zertifikate" aria-labelledby="zert-titel">
    <div class="wrap">
      <div class="zert-kopf">
        <div>
          <p class="notiz">Qualität mit System</p>
          <h2 id="zert-titel">Zertifizierte Standards.<br />Nachvollziehbare Leistung.</h2>
        </div>
        <p>Von der Einsatzorganisation bis zum Umweltmanagement: verbindliche Prozesse für die Zusammenarbeit.</p>
      </div>
      <ul class="zert-raster">
        {
          zertifikate.map((z) => (
            <li class="zert">
              <Icon name={z.symbol} class="zert-symbol" />
              <h3><span>{z.norm}</span>{z.nummer}</h3>
              <p class="zert-bereich">{z.bereich}</p>
              <p>{z.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="zert-fuss">Zertifikate legen wir auf Anfrage vor.</p>
    </div>
  </section>

  <section class="wrap kontakt" id="kontakt" aria-labelledby="kontakt-titel">
    <h2 id="kontakt-titel">Ein Ansprechpartner für alle drei Bereiche.</h2>
    <div class="kontakt-wege">
      <a href={firma.telefonHref}><span><small>Anrufen</small>{firma.telefon}</span><Icon name="pfeilSchraeg" /></a>
      <a href={`mailto:${firma.email}`}><span><small>E-Mail</small>{firma.email}</span><Icon name="pfeilSchraeg" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .buehne {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: 560px;
    padding: 64px 64px 168px;
    border-radius: 28px;
    color: #fff;
    background: linear-gradient(114deg, var(--brand) 5%, var(--mid) 53%, var(--deep) 100%);
  }

  .kunst-rahmen {
    position: absolute;
    right: -40px;
    top: -30px;
    width: 640px;
    height: 660px;
  }

  .kunst-rahmen :global(.kunst) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .buehne-text {
    position: relative;
    z-index: 1;
  }

  .etikett {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 13px;
    border: 1px solid #ffffff40;
    border-radius: 30px;
    background: #ffffff0d;
    font-size: 13px;
    font-weight: 500;
    color: #ecf2ff;
  }

  .etikett i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cad9ff;
    box-shadow: 0 0 0 4px #ffffff14;
  }

  h1 {
    margin: 30px 0 22px;
    font-size: clamp(56px, 5.6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.058em;
    font-weight: 560;
  }

  .lead {
    max-width: 440px;
    font-size: 18px;
    line-height: 1.65;
    color: #eef3ff;
  }

  .tueren {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: -128px 40px 0;
  }

  .tuer {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 236px;
    padding: 26px 26px 22px;
    border-radius: 20px;
    overflow: hidden;
    color: #fff;
    box-shadow: 0 18px 40px -18px rgba(6, 20, 60, 0.55);
    transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  a.tuer:hover {
    transform: translateY(-4px);
  }

  .tuer.s {
    background: linear-gradient(150deg, #12407a, #071d3d);
  }

  .tuer.f {
    background: linear-gradient(150deg, #c2410c, #5e1509);
  }

  .tuer.v {
    background: linear-gradient(150deg, #16834f, #073d29);
  }

  .tuer :global(.ico-gross) {
    width: 46px;
    height: 46px;
    padding: 9px;
    border: 1px solid #ffffff33;
    border-radius: 12px;
    background: #ffffff1f;
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tuer small {
    margin-top: auto;
    font-size: 12px;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .tuer h2 {
    margin-top: 6px;
    font-size: 26px;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .tuer p {
    min-height: 3.2em;
    margin-top: 6px;
    max-width: 320px;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.88;
  }

  .pfeil {
    position: absolute;
    top: 24px;
    right: 24px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
  }

  .bald {
    position: absolute;
    top: 30px;
    right: 24px;
    padding: 5px 10px;
    border: 1px solid #ffffff4d;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ueber {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    padding: 96px 0 88px;
  }

  .notiz {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand);
  }

  .ueber h2 {
    font-size: 42px;
    line-height: 1.12;
    letter-spacing: -0.045em;
    font-weight: 560;
  }

  .fakten {
    border-top: 1px solid var(--line);
  }

  .fakten li {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .fakten b {
    font-weight: 600;
  }

  .fakten span {
    color: var(--muted);
  }

  .zertifikate {
    padding: 64px 0 40px;
    background: #263b56;
    color: #fff;
  }

  .zert-kopf {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 34px;
  }

  .zertifikate .notiz {
    color: #bed0e4;
  }

  .zert-kopf h2 {
    font-size: 36px;
    line-height: 1.17;
    letter-spacing: -0.04em;
    font-weight: 560;
  }

  .zert-kopf > p {
    max-width: 340px;
    font-size: 14px;
    line-height: 1.7;
    color: #dce4ee;
  }

  .zert-raster {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .zert {
    padding: 25px 21px 24px;
    border: 1px solid #50627a;
    border-radius: 6px;
    background: #2c415c;
  }

  .zert :global(.zert-symbol) {
    display: block;
    width: 42px;
    height: 42px;
    margin-bottom: 17px;
    fill: none;
    stroke: #bed0e4;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .zert h3 {
    margin-bottom: 18px;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 580;
  }

  .zert h3 span {
    display: block;
    margin-bottom: 7px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.025em;
    color: #bed0e4;
  }

  .zert-bereich {
    min-height: 38px;
    margin-bottom: 9px;
    font-size: 12px;
    font-weight: 600;
  }

  .zert p:last-child {
    font-size: 12px;
    line-height: 1.65;
    color: #dce4ee;
    hyphens: auto;
  }

  .zert-fuss {
    margin-top: 21px;
    text-align: right;
    font-size: 12px;
    color: #dce4ee;
  }

  .kontakt {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
    margin: 72px auto 28px;
    padding: 56px 64px;
    border-radius: 28px;
    background: var(--nacht);
    color: #fff;
  }

  .kontakt h2 {
    font-size: 40px;
    line-height: 1.12;
    letter-spacing: -0.045em;
    font-weight: 550;
  }

  .kontakt-wege {
    display: grid;
    gap: 12px;
  }

  .kontakt-wege a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    border: 1px solid #ffffff26;
    border-radius: 14px;
    background: #ffffff0f;
    font-size: 24px;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    transition: background-color 0.16s;
  }

  .kontakt-wege a:hover {
    background: #ffffff1c;
  }

  .kontakt-wege small {
    display: block;
    margin-bottom: 2px;
    font-size: 12px;
    letter-spacing: 0;
    color: #b7c6e6;
  }

  @media (max-width: 1150px) {
    .zert-raster {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .zert {
      grid-column: span 2;
    }

    .zert:nth-child(n + 4) {
      grid-column: span 3;
    }
  }

  @media (max-width: 720px) {
    .buehne {
      display: block;
      min-height: 0;
      padding: 30px 24px 200px;
      border-radius: 22px;
    }

    .kunst-rahmen {
      width: 300px;
      height: 310px;
      right: -70px;
      top: auto;
      bottom: -110px;
    }

    h1 {
      margin: 22px 0 16px;
      font-size: clamp(42px, 12vw, 56px);
    }

    .lead {
      font-size: 16px;
    }

    .tueren {
      grid-template-columns: 1fr;
      gap: 10px;
      margin: 14px 0 0;
    }

    .tuer {
      display: grid;
      grid-template-columns: 44px 1fr auto;
      align-items: center;
      gap: 4px 14px;
      min-height: 0;
      padding: 18px 16px;
      border-radius: 16px;
    }

    .tuer :global(.ico-gross) {
      grid-row: 1 / 3;
      width: 44px;
      height: 44px;
    }

    .tuer small {
      grid-column: 2;
      margin: 0;
      font-size: 11px;
    }

    .tuer h2 {
      grid-column: 2;
      margin: 0;
      font-size: 20px;
    }

    .tuer p {
      grid-column: 1 / -1;
      min-height: 0;
      margin-top: 8px;
      font-size: 13px;
    }

    .pfeil,
    .bald {
      position: static;
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .pfeil {
      width: 36px;
      height: 36px;
    }

    .ueber {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 56px 0 48px;
    }

    .ueber h2 {
      font-size: 31px;
    }

    .fakten li {
      grid-template-columns: 1fr;
      gap: 2px;
      padding: 16px 0;
    }

    .zertifikate {
      padding: 44px 0 30px;
    }

    .zert-kopf {
      display: block;
      margin-bottom: 24px;
    }

    .zert-kopf h2 {
      font-size: 29px;
    }

    .zert-kopf > p {
      margin-top: 14px;
    }

    .zert-raster {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .zert,
    .zert:nth-child(n + 4) {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 4px 14px;
      grid-column: auto;
      padding: 18px 16px;
    }

    .zert :global(.zert-symbol) {
      grid-row: 1 / 4;
      width: 34px;
      height: 34px;
      margin: 0;
    }

    .zert h3 {
      margin: 0 0 4px;
      font-size: 28px;
    }

    .zert-bereich {
      min-height: 0;
      margin: 0;
    }

    .zert-fuss {
      text-align: left;
    }

    .kontakt {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-top: 48px;
      padding: 32px 22px;
      border-radius: 22px;
    }

    .kontakt h2 {
      font-size: 30px;
    }

    .kontakt-wege a {
      padding: 16px 18px;
      font-size: 20px;
    }
  }
</style>
