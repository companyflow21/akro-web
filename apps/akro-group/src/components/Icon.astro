---
/**
 * Eigene Liniensymbole (keine Logos von Zertifizierungsstellen).
 * Strichfarbe folgt currentColor.
 */
const SYMBOLE = {
  // Bereiche, 40er-Raster
  schild: ['0 0 40 40', '<path d="m20 4 13 5v10c0 8-5 13-13 17C12 32 7 27 7 19V9Z"/><path d="m14 19 4 4 9-10"/>'],
  flamme: ['0 0 40 40', '<path d="M21 4c2 8 10 11 10 20a11 11 0 0 1-22 0c0-5 3-10 7-14 0 6 2 8 4 9 3-4 3-9 1-15Z"/><path d="M20 24c-3 3-4 5-4 7a4 4 0 0 0 8 0c0-2-2-4-4-7Z"/>'],
  paket: ['0 0 40 40', '<path d="m20 5 14 8v15l-14 8-14-8V13Z"/><path d="m6 13 14 8 14-8M20 21v15M13 9l14 8v7"/>'],
  // Zertifikate, 64er-Raster
  helm: ['0 0 64 64', '<path d="M16 39v-5c0-8 5-14 12-16m8 0c7 2 12 8 12 16v5M27 29V17a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v12M12 39h40v7H12ZM22 46v4h20v-4"/>'],
  dokument: ['0 0 64 64', '<rect x="15" y="14" width="34" height="38" rx="3"/><path d="m24 33 6 6 12-14"/>'],
  person: ['0 0 64 64', '<circle cx="32" cy="20" r="6"/><path d="M19 43v-4c0-7 6-12 13-12s13 5 13 12v4M25 35v9m14-9v9M13 35v6c0 8 9 13 19 16 10-3 19-8 19-16v-6"/>'],
  blatt: ['0 0 64 64', '<path d="M18 40C11 23 30 15 49 17c0 18-7 32-21 30-5 0-8-3-10-7ZM15 52l26-27M24 42V30m0 12h12"/>'],
  schildGross: ['0 0 64 64', '<path d="m32 15 14 6v12c0 9-6 15-14 20-8-5-14-11-14-20V21Z"/><path d="m25 33 5 5 10-12"/>'],
  // Bedienelemente, 24er-Raster
  telefon: ['0 0 24 24', '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>'],
  brief: ['0 0 24 24', '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>'],
  pfeilSchraeg: ['0 0 24 24', '<path d="M7 17 17 7M8 7h9v9"/>'],
  pfeilLinks: ['0 0 24 24', '<path d="M19 12H5m6-6-6 6 6 6"/>'],
} as const;

export type SymbolName = keyof typeof SYMBOLE;

interface Props {
  name: SymbolName;
  class?: string;
}

const { name, class: klasse = 'ico' } = Astro.props;
const [viewBox, inhalt] = SYMBOLE[name];
---

<svg class={klasse} viewBox={viewBox} aria-hidden="true" set:html={inhalt} />
