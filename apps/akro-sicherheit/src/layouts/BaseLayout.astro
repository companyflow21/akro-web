---
/**
 * Grundlayout aller Seiten von akro-sicherheit.de im Look 3, Layout
 * „Leitstelle“. Setzt Sprache, Farbwelt, Viewport und den SEO-Kopf.
 * Kopf- und Fußbereich sind auf jeder Seite identisch; auf dem Handy steht
 * zusätzlich die feste Kontaktleiste (docs/DECISIONS.md Punkt 32).
 */
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '@akro/assets/brand/akro/favicon.svg';
import { marke } from '../config';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="de" data-marke="sicherheit">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#061630" />
		<link rel="icon" href={favicon.src} type="image/svg+xml" />
		<Seo
			title={title}
			description={description}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="overflow-x-hidden">
		<a
			href="#inhalt"
			class="tech sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-sand"
		>
			Zum Inhalt springen
		</a>

		<Header />

		<main id="inhalt">
			<slot />
		</main>

		<Footer />

		<nav class="aktionsleiste lg:hidden" aria-label="Schnellkontakt">
			<a class="leise" href={marke.telefonHref}>
				<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
				Anrufen
			</a>
			<a class="laut" href="/anfrage">
				<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
				Einsatz anfragen
			</a>
		</nav>
	</body>
</html>

<style>
	.aktionsleiste {
		position: fixed;
		z-index: 20;
		left: 12px;
		right: 12px;
		bottom: 12px;
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 8px;
		padding: 8px;
		border-radius: 18px;
		background: var(--color-ink);
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
	}

	.aktionsleiste a {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		min-height: 50px;
		border-radius: 12px;
		font-size: 15px;
		font-weight: 600;
	}

	.leise {
		color: #e6f4fb;
		background: rgb(255 255 255 / 0.08);
	}

	.laut {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	@media (min-width: 1024px) {
		.aktionsleiste {
			display: none;
		}
	}
</style>
