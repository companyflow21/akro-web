---
/**
 * Kopfbereich nach docs/SITE-ARCHITECTURE.md §5, Look 3 „Leitstelle“:
 * dunkle Leiste mit der Wortmarke in Weiß bis Cyan.
 *
 * Die Startseite wird ausschließlich über das Logo erreicht und hat keinen
 * eigenen Navigationspunkt. Rechtstexte gehören nicht in die
 * Hauptnavigation. Mobile Navigation ohne JavaScript über details/summary;
 * Telefon und Anfrage stehen auf dem Handy in der festen Kontaktleiste.
 */
import { marke, hauptnavigation } from '../config';
import logo from '@akro/assets/brand/akro-security/akro-sicherheit.svg';

const pfad = Astro.url.pathname;
const istAktiv = (href: string) =>
  pfad === href || pfad.startsWith(href + '/');
---

<header class="kopf bg-ink text-sand">
	<div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-4 md:px-8">
		<a href="/" class="flex shrink-0 items-center gap-3.5" aria-label={`${marke.name} — Startseite`}>
			<img src={logo.src} width="1025" height="263" alt="AKRO" class="h-auto w-[104px] md:w-[124px]" />
			<span class="border-l border-white/20 pl-3.5 text-klein font-semibold text-[#6fe3f0]">Sicherheit</span>
		</a>

		<nav aria-label="Hauptnavigation" class="ml-auto hidden lg:block">
			<ul class="flex items-center gap-7">
				{
					hauptnavigation.map((eintrag) => (
						<li>
							<a
								href={eintrag.href}
								aria-current={istAktiv(eintrag.href) ? 'page' : undefined}
								class="text-klein font-medium text-sand/75 hover:text-white aria-[current=page]:text-accent"
							>
								{eintrag.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a href="/anfrage" class="btn btn--rand hidden lg:ml-6 lg:inline-flex">
			Einsatz anfragen
		</a>

		<details class="menue ml-auto lg:hidden">
			<summary aria-label="Menü öffnen">
				<span aria-hidden="true"></span>
				Menü
			</summary>
			<nav aria-label="Hauptnavigation mobil">
				<ul>
					{
						hauptnavigation.map((eintrag) => (
							<li>
								<a
									href={eintrag.href}
									aria-current={istAktiv(eintrag.href) ? 'page' : undefined}
								>
									{eintrag.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</details>
	</div>
</header>

<style>
	.kopf {
		position: relative;
		z-index: 30;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}

	.btn--rand {
		border-color: var(--color-accent);
		color: #6fe3f0;
	}

	.btn--rand:hover {
		background: rgb(0 201 224 / 0.12);
	}

	.menue summary {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 14px;
		border: 1px solid rgb(255 255 255 / 0.2);
		border-radius: 10px;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	.menue summary::-webkit-details-marker {
		display: none;
	}

	.menue summary span,
	.menue summary span::before,
	.menue summary span::after {
		display: block;
		width: 16px;
		height: 1.5px;
		background: currentColor;
	}

	.menue summary span {
		position: relative;
	}

	.menue summary span::before,
	.menue summary span::after {
		content: "";
		position: absolute;
		left: 0;
	}

	.menue summary span::before {
		top: -5px;
	}

	.menue summary span::after {
		top: 5px;
	}

	.menue nav {
		position: absolute;
		left: 12px;
		right: 12px;
		top: calc(100% + 6px);
		padding: 8px 18px;
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: 16px;
		background: var(--color-ink-2);
		box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
	}

	.menue li + li {
		border-top: 1px solid rgb(255 255 255 / 0.1);
	}

	.menue nav a {
		display: block;
		padding: 14px 0;
		font-size: 16px;
		color: #e6eef7;
	}

	.menue nav a[aria-current="page"] {
		color: var(--color-accent);
	}
</style>
