---
/**
 * Kontaktseite für allgemeine Fragen. Die strukturierte Angebotsanfrage
 * liegt getrennt auf /anfrage — beide werden nicht vermischt.
 *
 * Kein Formular, solange die Formulararchitektur offen ist (CLAUDE.md §14):
 * Kontakt läuft direkt über Telefon und E-Mail.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { marke } from '../config';
import { brotkrumen } from '../lib/jsonld';

const pfad = [
  { label: 'Startseite', href: '/' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<BaseLayout
	title="Kontakt | AKRO Sicherheit"
	description="Kontakt zur AKRO GmbH: Telefon, E-Mail und Anschrift. Für konkrete Einsätze nutzen Sie bitte die Angebotsanfrage."
	jsonLd={brotkrumen(pfad)}
>
	<Breadcrumb eintraege={pfad} />

	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
			<SectionHead eyebrow="Kontakt" titel="Direkt und verbindlich." as="h1">
				<p class="mt-6 max-w-xl text-vorspann leading-relaxed text-muted">
					Für allgemeine Fragen erreichen Sie uns telefonisch oder per E-Mail.
					Geht es um einen konkreten Einsatz, kommen Sie über die
					<a href="/anfrage" class="text-brand">Angebotsanfrage</a> schneller
					zum Ziel.
				</p>
			</SectionHead>
		</div>
	</section>

	<section class="border-y border-line bg-sand-2">
		<div
			class="mx-auto grid max-w-6xl gap-12 px-5 py-14 md:px-8 md:py-16 lg:grid-cols-[0.8fr_1fr] lg:gap-16"
		>
			<aside class="h-fit rounded-[16px] border border-line bg-surface p-7">
				<p class="tech text-muted">Erreichbarkeit</p>
				<dl class="mt-5 space-y-4 text-klein">
					<div>
						<dt class="tech text-muted">Telefon</dt>
						<dd class="mt-1">
							<a href={marke.telefonHref} class="text-vorspann font-semibold hover:text-brand">
								{marke.telefon}
							</a>
						</dd>
					</div>
					<div>
						<dt class="tech text-muted">E-Mail</dt>
						<dd class="mt-1">
							<a href={`mailto:${marke.email}`} class="hover:text-brand">
								{marke.email}
							</a>
						</dd>
					</div>
					<div>
						<dt class="tech text-muted">Anschrift</dt>
						<dd class="mt-1">
							{marke.traeger}<br />
							{marke.strasse}<br />
							{marke.plz} {marke.ort}
						</dd>
					</div>
					<div>
						<dt class="tech text-muted">Niederlassung</dt>
						<dd class="mt-1">{marke.niederlassung}</dd>
					</div>
				</dl>

			</aside>

			<div class="grid h-fit gap-3">
				<a href={`mailto:${marke.email}`} class="weg weg--voll">
					<span class="tech">E-Mail schreiben</span>
					<strong>{marke.email}</strong>
					<span class="text-klein">Für allgemeine Fragen, Unterlagen und Rückmeldungen.</span>
				</a>
				<a href={marke.telefonHref} class="weg">
					<span class="tech text-muted">Anrufen</span>
					<strong>{marke.telefon}</strong>
					<span class="text-klein text-muted">Direkt mit einem festen Ansprechpartner sprechen.</span>
				</a>
				<a href="/anfrage" class="weg">
					<span class="tech text-muted">Konkreter Einsatz?</span>
					<strong>Angebot anfragen</strong>
					<span class="text-klein text-muted">Mit den Angaben, die wir für ein Angebot brauchen.</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.weg {
		display: grid;
		gap: 6px;
		padding: 24px 24px 22px;
		border: 1px solid var(--color-line);
		border-radius: 16px;
		background: var(--color-surface);
		transition: border-color 0.18s, transform 0.18s;
	}

	.weg:hover {
		border-color: var(--color-brand);
		transform: translateY(-2px);
	}

	.weg strong {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		line-height: 1.2;
		letter-spacing: -0.03em;
		font-weight: 560;
		overflow-wrap: anywhere;
	}

	.weg--voll {
		border-color: transparent;
		background: var(--color-ink);
		color: #e6eef7;
	}

	.weg--voll .tech {
		color: var(--color-accent);
	}
</style>
