---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { marke } from '../config';
import { leistungen } from '../data/leistungen';
import { organisation } from '../lib/jsonld';

const ablauf = [
  {
    nr: '01',
    titel: 'Anfrage',
    text: 'Sie schildern Objekt, Zeitraum und Anforderungen.',
  },
  {
    nr: '02',
    titel: 'Abstimmung',
    text: 'Wir stimmen Leistungsverzeichnis, Besetzung und Ablauf mit Ihnen ab.',
  },
  {
    nr: '03',
    titel: 'Einsatz',
    text: 'Wir planen die Besetzung, führen den Einsatz durch und dokumentieren ihn.',
  },
];

// Bewusst ohne Kennzahlen und ohne Zertifikatsnennung: beides ist
// unbestätigt (docs/SITE-ARCHITECTURE.md §9).
const kompetenzen = [
  { label: 'Einsatzplanung', text: 'in eigener Verantwortung' },
  { label: 'Qualifikation', text: 'Nachweise je Einsatz geprüft' },
  { label: 'Dokumentation', text: 'nachvollziehbare Kontrollprotokolle' },
  { label: 'Ansprechpartner', text: 'fest zugeordnet' },
];
---

<BaseLayout
	title="AKRO Sicherheit | Sicherheitsdienst für Industrie und Gewerbe"
	description="AKRO Sicherheit übernimmt Objekt- und Werkschutz, Revierdienst, Veranstaltungssicherheit und Personenschutz — mit eigener Einsatzplanung und dokumentierten Abläufen."
	jsonLd={organisation()}
>
	{/* Hero */}
	<section class="bg-ink text-sand">
		<div
			class="mx-auto grid max-w-6xl gap-14 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1.15fr_1fr] lg:gap-20"
		>
			<div class="rail">
				<p class="tech text-accent">{marke.traeger} · Sicherheitsdienstleistungen</p>

				<h1
					class="mt-6 text-hero"
				>
					Sicherheit, die sich planen lässt.
				</h1>

				<p class="mt-6 max-w-xl text-vorspann text-sand/75">
					Wir übernehmen Bewachung und Kontrolle für Industrie, Gewerbe und
					öffentliche Auftraggeber — mit eigener Einsatzplanung, dokumentierten
					Abläufen und festen Ansprechpartnern.
				</p>

				<div class="mt-9 flex flex-wrap gap-3">
					<a href="/anfrage" class="btn btn--primary">Einsatz anfragen</a>
					<a href={marke.telefonHref} class="btn btn--ghost">
						{marke.telefon}
					</a>
				</div>
			</div>

			{/* Register der Leistungen statt eines Kennzahlenblocks: nennt
			    Belegbares statt unbestätigter Zahlen. */}
			<div class="lg:pt-3">
				<p class="tech text-sand/50">Leistungsregister</p>
				<ul class="mt-4">
					{
						leistungen.map((l) => (
							<li class="index-row">
								<span class="tech w-7 shrink-0 text-accent">{l.kuerzel}</span>
								<a
									href={`/leistungen/${l.slug}`}
									class="text-klein text-sand/85 hover:text-sand"
								>
									{l.titel}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	{/* Kompetenzleiste */}
	<section class="border-b border-line bg-sand-2">
		<div class="mx-auto max-w-6xl px-5 py-10 md:px-8">
			<dl class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
				{
					kompetenzen.map((k) => (
						<div>
							<dt class="tech text-brand">{k.label}</dt>
							<dd class="mt-2 text-klein text-ink/80">{k.text}</dd>
						</div>
					))
				}
			</dl>
			<p class="mt-8 border-t border-line pt-4 text-marginalie text-muted">
				<span class="todo">TODO</span>
				Zertifikate, Normen und Kennzahlen erscheinen erst, wenn die
				Originalnachweise geprüft und zur Veröffentlichung freigegeben sind.
			</p>
		</div>
	</section>

	{/* Leistungen */}
	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
			<SectionHead
				eyebrow="Leistungen"
				titel="Sieben Leistungen, ein Ansprechpartner."
			/>

			<div class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
				{
					leistungen.map((l, i) => (
						<ServiceCard leistung={l} breit={i === 0} />
					))
				}
			</div>
		</div>
	</section>

	{/* Ablauf — hier ist die Nummerierung inhaltlich begründet */}
	<section class="bg-ink-2 text-sand">
		<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
			<SectionHead
				eyebrow="Ablauf"
				titel="Von der Anfrage bis zum Einsatz."
				invers
			/>

			<ol class="mt-12 grid gap-px bg-ink-3 md:grid-cols-3">
				{
					ablauf.map((s) => (
						<li class="bg-ink-2 p-7">
							<span class="tech text-accent">{s.nr}</span>
							<h3 class="mt-3">{s.titel}</h3>
							<p class="mt-2 text-klein text-sand/70">
								{s.text}
							</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* Unternehmen */}
	<section class="bg-sand">
		<div
			class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1fr_0.85fr] lg:gap-20"
		>
			<div>
				<SectionHead
					eyebrow="Auftragsverhältnis"
					titel="Wir erbringen die Leistung, nicht nur die Besetzung."
				>
					<p class="mt-6 max-w-xl text-vorspann text-muted">
						Die {marke.traeger} erbringt Sicherheitsdienstleistungen als
						eigenverantwortlich organisierte Leistung. Auswahl und Anzahl der
						eingesetzten Kräfte, Einsatzplanung, Arbeitszeiten, Vertretung und
						Führung liegen bei uns. Sie beauftragen ein Ergebnis nach
						Leistungsverzeichnis.
					</p>
					<p class="mt-6">
						<a href="/unternehmen" class="tech text-brand">
							Mehr über das Unternehmen
						</a>
					</p>
				</SectionHead>
			</div>

			<aside class="border border-line bg-surface p-7">
				<p class="tech text-muted">Rechtsträger</p>
				<p class="mt-3 text-karte">{marke.traeger}</p>
				<dl class="mt-6 space-y-4 text-klein">
					<div>
						<dt class="tech text-muted">Sitz</dt>
						<dd class="mt-1">{marke.strasse}, {marke.plz} {marke.ort}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Niederlassung</dt>
						<dd class="mt-1">{marke.niederlassung}</dd>
					</div>
					<div>
						<dt class="tech text-muted">Telefon</dt>
						<dd class="mt-1">
							<a href={marke.telefonHref} class="hover:text-brand">
								{marke.telefon}
							</a>
						</dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>

	<CtaBand />
</BaseLayout>
