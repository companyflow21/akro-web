---
/**
 * Angebotsanfrage per E-Mail.
 *
 * Solange die Formulararchitektur offen ist (CLAUDE.md §14), öffnet die
 * Anfrage eine vorbereitete E-Mail. Die Felder folgen dem erprobten Schema
 * des Altbestands (docs/LEGACY-INVENTORY.md §3) und bleiben die
 * Spezifikation für ein späteres Formular.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { marke } from '../config';
import { leistungen } from '../data/leistungen';
import { brotkrumen } from '../lib/jsonld';

const pfad = [
  { label: 'Startseite', href: '/' },
  { label: 'Anfrage', href: '/anfrage' },
];

const angaben = [
  { feld: 'Leistung', hinweis: `zum Beispiel ${leistungen[0].titel}` },
  { feld: 'Einsatzort', hinweis: 'Anschrift oder Gelände' },
  { feld: 'Zeitraum', hinweis: 'Beginn und, falls bekannt, Ende' },
  { feld: 'Einsatzzeiten', hinweis: 'Tage und Uhrzeiten' },
  { feld: 'Umfang', hinweis: 'zum Beispiel Anzahl der Posten oder Stunden' },
  { feld: 'Kontakt', hinweis: 'Name, Unternehmen und Telefon für Rückfragen' },
];

const vorlage = [
  'Leistung:',
  'Einsatzort:',
  'Beginn:',
  'Ende:',
  'Einsatzzeiten:',
  'Umfang:',
  '',
  'Name:',
  'Unternehmen:',
  'Telefon:',
].join('\n');

const mailto = `mailto:${marke.email}?subject=${encodeURIComponent(
  'Anfrage AKRO Sicherheit',
)}&body=${encodeURIComponent(vorlage)}`;
---

<BaseLayout
	title="Angebot anfragen | AKRO Sicherheit"
	description="Fordern Sie ein Angebot für Objektschutz, Revierdienst, Veranstaltungssicherheit oder eine andere Sicherheitsleistung an."
	jsonLd={brotkrumen(pfad)}
>
	<Breadcrumb eintraege={pfad} />

	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
			<SectionHead
				eyebrow="Anfrage"
				titel="Objekt, Zeitraum, Anforderungen — den Rest planen wir."
				as="h1"
			>
				<p class="mt-6 max-w-xl text-vorspann leading-relaxed text-muted">
					Je genauer Ihre Angaben, desto konkreter unser Vorschlag zu Besetzung
					und Ablauf. Fehlende Angaben klären wir im Gespräch.
				</p>
			</SectionHead>
		</div>
	</section>

	<section class="border-y border-line bg-sand-2">
		<div
			class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:px-8 md:py-16 lg:grid-cols-[1fr_0.9fr] lg:gap-16"
		>
			<div>
				<h2 class="text-abschnitt">Diese Angaben brauchen wir</h2>
				<ul class="mt-6 grid gap-2.5">
					{
						angaben.map((a, i) => (
							<li class="flex gap-4 rounded-[12px] border border-line bg-surface px-4 py-3.5">
								<span class="tech mt-0.5 text-brand">{String(i + 1).padStart(2, '0')}</span>
								<span class="text-klein">
									<strong class="font-semibold">{a.feld}</strong>
									<span class="text-muted"> – {a.hinweis}</span>
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="grid h-fit gap-3">
				<a href={mailto} class="weg weg--voll">
					<span class="tech">Anfrage per E-Mail</span>
					<strong>{marke.email}</strong>
					<span class="text-klein">Öffnet Ihr E-Mail-Programm mit vorbereiteten Feldern.</span>
				</a>
				<a href={marke.telefonHref} class="weg">
					<span class="tech text-muted">Lieber anrufen</span>
					<strong>{marke.telefon}</strong>
					<span class="text-klein text-muted">Wir nehmen Ihre Angaben direkt auf.</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.weg {
		display: grid;
		gap: 6px;
		padding: 24px 24px 22px;
		border: 1px solid var(--color-line);
		border-radius: 16px;
		background: var(--color-surface);
		transition: border-color 0.18s, transform 0.18s;
	}

	.weg:hover {
		border-color: var(--color-brand);
		transform: translateY(-2px);
	}

	.weg strong {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		line-height: 1.2;
		letter-spacing: -0.03em;
		font-weight: 560;
		overflow-wrap: anywhere;
	}

	.weg--voll {
		border-color: transparent;
		background: var(--color-ink);
		color: #e6eef7;
	}

	.weg--voll .tech {
		color: var(--color-accent);
	}
</style>
