---
/**
 * Impressum für akro-sicherheit.de, gleichlautend mit akro-group.de.
 * Angaben vom Auftraggeber bestätigt (Impressum des Platzhalters, Stand
 * 05.09.2026, und docs/DECISIONS.md). Vor Veröffentlichung rechtlich prüfen
 * lassen (CLAUDE.md §13).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { marke } from '../config';

const pfad = [
  { label: 'Startseite', href: '/' },
  { label: 'Impressum', href: '/impressum' },
];
---

<BaseLayout
	title="Impressum | AKRO Sicherheit"
	description="Impressum und Anbieterkennzeichnung der AKRO GmbH für AKRO Sicherheit."
>
	<Breadcrumb eintraege={pfad} />

	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
			<SectionHead eyebrow="Rechtliches" titel="Impressum" as="h1" />

			<div class="prose mt-10 max-w-2xl rounded-[16px] border border-line bg-surface p-6 md:p-10">
			<h2>Angaben gemäß § 5 DDG</h2>
			<p>
			  AKRO GmbH<br />
			  Saarwellinger Straße 25<br />
			  66740 Saarlouis<br />
			  Deutschland
			</p>
			<p>Niederlassung Bonn</p>

			<h2>Vertreten durch</h2>
			<p>Geschäftsführer: Wagdee Al Muliki</p>

			<h2>Kontakt</h2>
			<p>
			  Telefon: <a href="tel:+4922818456685">0228 18456685</a><br />
			  E-Mail: <a href={`mailto:${marke.email}`}>{marke.email}</a>
			</p>

			<h2>Registereintrag</h2>
			<p>
			  Eintragung im Handelsregister<br />
			  Registergericht: Amtsgericht Saarbrücken<br />
			  Registernummer: HRB 112267
			</p>

			<h2>Umsatzsteuer-Identifikationsnummer</h2>
			<p>
			  Umsatzsteuer-Identifikationsnummer gemäß § 27 a
			  Umsatzsteuergesetz:<br />
			  DE463797867
			</p>

			<h2>Erlaubnis nach § 34a Gewerbeordnung</h2>
			<p>
			  Die AKRO GmbH übt das Bewachungsgewerbe auf Grundlage der Erlaubnis
			  nach § 34a Gewerbeordnung aus. Die Berufsbezeichnung
			  „Bewachungsgewerbe“ wurde in der Bundesrepublik Deutschland
			  verliehen.
			</p>
			<p>
			  Erteilende und zuständige Aufsichtsbehörde:<br />
			  Landkreis Saarlouis, Amt für öffentliche Sicherheit und Ordnung,
			  Kaiser-Wilhelm-Straße 4, 66740 Saarlouis
			</p>
			<p>
			  Maßgebliche berufsrechtliche Regelungen: § 34a Gewerbeordnung sowie
			  die Bewachungsverordnung (BewachV), einsehbar unter <a href="https://www.gesetze-im-internet.de">gesetze-im-internet.de</a>.
			</p>

			<h2>Berufshaftpflichtversicherung</h2>
			<p>Allianz Versicherungs-AG<br>Königinstraße 28<br>80802 München<br>Räumlicher Geltungsbereich: Deutschland</p>

			<h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
			<p>
			  Wagdee Al Muliki<br />
			  Saarwellinger Straße 25<br />
			  66740 Saarlouis
			</p>

			<h2>Streitbeilegung</h2>
			<p>
			  Wir sind nicht bereit und nicht verpflichtet, an
			  Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
			  teilzunehmen.
			</p>

			<h2>Haftung für Links</h2>
			<p>
			  Unser Angebot enthält Links zu externen Websites Dritter, auf deren
