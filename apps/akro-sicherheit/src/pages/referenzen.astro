---
/**
 * Referenzen ohne Kundennamen und ohne Logos.
 *
 * Für keinen Kunden liegt eine dokumentierte Veröffentlichungsfreigabe vor
 * (docs/LEGACY-INVENTORY.md, docs/SITE-ARCHITECTURE.md §9). Die Seite
 * beschreibt deshalb Einsatzarten statt Kunden — das ist belegbar und
 * rechtlich unbedenklich.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { brotkrumen } from '../lib/jsonld';

const pfad = [
  { label: 'Startseite', href: '/' },
  { label: 'Referenzen', href: '/referenzen' },
];

const einsatzarten = [
  {
    titel: 'Industrie und Produktion',
    text: 'Werkschutz, Zutrittskontrolle und Kontrollgänge auf Produktions- und Werksgeländen.',
  },
  {
    titel: 'Gewerbe und Handel',
    text: 'Objektschutz und Revierdienst für Gewerbeobjekte und Handelsflächen.',
  },
  {
    titel: 'Veranstaltungen',
    text: 'Einlasskontrolle, Besucherlenkung und Absicherung von Auf- und Abbau.',
  },
  {
    titel: 'Bauwirtschaft',
    text: 'Bewachung von Baustellen, Material und Maschinen außerhalb der Arbeitszeit.',
  },
];
---

<BaseLayout
	title="Referenzen | AKRO Sicherheit"
	description="Einsatzarten, in denen AKRO Sicherheit tätig ist: Industrie, Gewerbe, Veranstaltungen und Bauwirtschaft."
	jsonLd={brotkrumen(pfad)}
>
	<Breadcrumb eintraege={pfad} />

	<section class="bg-sand">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
			<SectionHead eyebrow="Referenzen" titel="Wo wir eingesetzt werden." as="h1">
				<p class="mt-6 max-w-xl text-vorspann leading-relaxed text-muted">
					Wir nennen Auftraggeber ausschließlich mit deren ausdrücklicher
					Zustimmung. Auf Anfrage benennen wir Ihnen passende Referenzen im
					persönlichen Gespräch.
				</p>
			</SectionHead>

			<div class="mt-12 grid gap-px bg-line sm:grid-cols-2">
				{
					einsatzarten.map((e) => (
						<article class="card">
							<h2 class="text-vorspann font-semibold tracking-[-0.01em]">
								{e.titel}
							</h2>
							<p class="text-klein leading-relaxed text-muted">{e.text}</p>
						</article>
					))
				}
			</div>

			<p class="mt-10 max-w-2xl border-t border-line pt-5 text-marginalie text-muted">
				<span class="todo">TODO</span>
				Namentliche Referenzen, Kundenlogos und Projektbeschreibungen erst nach
				schriftlicher Veröffentlichungsfreigabe je Auftraggeber ergänzen.
			</p>
		</div>
	</section>

	<CtaBand />
</BaseLayout>
